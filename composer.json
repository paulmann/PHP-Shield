{
    "name": "paulmann/php-shield",
    "description": "Professional modular PHP security middleware: threat detection, rate limiting, IP blocking, and defense-in-depth for PHP applications.",
    "type": "library",
    "license": "MIT",
    "keywords": ["php", "security", "middleware", "waf", "rate-limiting", "xss", "sqli", "ip-blocking", "redis"],
    "authors": [
        {
            "name": "Mikhail Deynekin",
            "email": "Mikhail@Deynekin.com",
            "homepage": "https://Deynekin.com"
        }
    ],
    "support": {
        "issues": "https://github.com/paulmann/PHP-Shield/issues",
        "source": "https://github.com/paulmann/PHP-Shield",
        "docs": "https://github.com/paulmann/PHP-Shield/blob/main/docs/wiki.md"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-mysqli": "Required for MysqlBlockStore, DatabaseRateLimiter and the admin dashboard",
        "ext-redis": "Required for RedisRateLimiter (recommended for production)"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Deynekin\\PhpShield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Deynekin\\PhpShield\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite",
        "phpstan": "Static analysis at level max (see phpstan.neon)",
        "cs-check": "Report coding-standard violations without changing files",
        "cs-fix": "Apply the coding standard"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
